+
+/* DPAPI-NG protection descriptors.
+ *
+ * Secrets are protected with classic DPAPI (CryptProtectData) and wrapped in a Wine-specific
+ * container that also stores the descriptor string. The blobs are therefore not interchangeable
+ * with blobs produced by Windows, and principals other than the current user or machine are
+ * not enforced. */
+
+#define PROTECTED_SECRET_MAGIC 0x5350574e /* "NWPS" */
+
+struct protection_descriptor
+{
+    DWORD magic;
+    BOOL  machine;
+    WCHAR *string;
+};
+
+struct protected_secret_header
+{
+    DWORD magic;
+    DWORD descriptor_len; /* in WCHARs, including the terminator */
+};
+
+static BOOL match_prefix(const WCHAR *str, const WCHAR *prefix, const WCHAR **value)
+{
+    size_t len = wcslen(prefix);
+
+    if (wcsnicmp(str, prefix, len)) return FALSE;
+    *value = str + len;
+    return TRUE;
+}
+
+static SECURITY_STATUS create_descriptor(const WCHAR *string, struct protection_descriptor **ret)
+{
+    struct protection_descriptor *descriptor;
+    const WCHAR *value;
+    BOOL machine = FALSE;
+
+    while (*string == ' ') string++;
+
+    if (match_prefix(string, L"LOCAL=", &value))
+    {
+        if (!wcsicmp(value, L"machine")) machine = TRUE;
+        else if (wcsicmp(value, L"user") && wcsicmp(value, L"logon"))
+        {
+            WARN("unknown LOCAL value %s\n", debugstr_w(value));
+            return NTE_INVALID_PARAMETER;
+        }
+    }
+    else if (match_prefix(string, L"SID=", &value))
+    {
+        if (!*value) return NTE_INVALID_PARAMETER;
+        FIXME("SID %s is not enforced, protecting for the current user\n", debugstr_w(value));
+    }
+    else
+    {
+        FIXME("unsupported descriptor %s\n", debugstr_w(string));
+        return NTE_NOT_SUPPORTED;
+    }
+
+    if (!(descriptor = calloc(1, sizeof(*descriptor)))) return NTE_NO_MEMORY;
+    if (!(descriptor->string = wcsdup(string)))
+    {
+        free(descriptor);
+        return NTE_NO_MEMORY;
+    }
+    descriptor->magic = PROTECTED_SECRET_MAGIC;
+    descriptor->machine = machine;
+    *ret = descriptor;
+    return ERROR_SUCCESS;
+}
+
+static struct protection_descriptor *get_descriptor(NCRYPT_DESCRIPTOR_HANDLE handle)
+{
+    struct protection_descriptor *descriptor = (struct protection_descriptor *)handle;
+
+    if (!descriptor || descriptor->magic != PROTECTED_SECRET_MAGIC) return NULL;
+    return descriptor;
+}
+
+static void *alloc_secret(const NCRYPT_ALLOC_PARA *para, SIZE_T size)
+{
+    if (para && para->pfnAlloc) return para->pfnAlloc(size);
+    return LocalAlloc(LMEM_FIXED, size);
+}
+
+SECURITY_STATUS WINAPI NCryptCreateProtectionDescriptor(const WCHAR *string, DWORD flags,
+                                                        NCRYPT_DESCRIPTOR_HANDLE *handle)
+{
+    struct protection_descriptor *descriptor;
+    SECURITY_STATUS ret;
+
+    TRACE("(%s, %#lx, %p)\n", debugstr_w(string), flags, handle);
+
+    if (!string || !handle) return NTE_INVALID_PARAMETER;
+    if (flags & NCRYPT_NAMED_DESCRIPTOR_FLAG)
+    {
+        FIXME("named descriptors not supported\n");
+        return NTE_NOT_SUPPORTED;
+    }
+
+    if ((ret = create_descriptor(string, &descriptor))) return ret;
+    *handle = (NCRYPT_DESCRIPTOR_HANDLE)descriptor;
+    return ERROR_SUCCESS;
+}
+
+SECURITY_STATUS WINAPI NCryptCloseProtectionDescriptor(NCRYPT_DESCRIPTOR_HANDLE handle)
+{
+    struct protection_descriptor *descriptor = get_descriptor(handle);
+
+    TRACE("(%p)\n", handle);
+
+    if (!descriptor) return NTE_INVALID_HANDLE;
+    descriptor->magic = 0;
+    free(descriptor->string);
+    free(descriptor);
+    return ERROR_SUCCESS;
+}
+
+SECURITY_STATUS WINAPI NCryptProtectSecret(NCRYPT_DESCRIPTOR_HANDLE handle, DWORD flags, const BYTE *data,
+                                           ULONG data_size, const NCRYPT_ALLOC_PARA *para, HWND hwnd,
+                                           BYTE **blob, ULONG *blob_size)
+{
+    struct protection_descriptor *descriptor = get_descriptor(handle);
+    struct protected_secret_header header;
+    DATA_BLOB in, out;
+    DWORD dpapi_flags = CRYPTPROTECT_UI_FORBIDDEN;
+    SIZE_T descriptor_bytes, size;
+    BYTE *ptr;
+
+    TRACE("(%p, %#lx, %p, %lu, %p, %p, %p, %p)\n", handle, flags, data, data_size, para, hwnd, blob, blob_size);
+
+    if (!descriptor) return NTE_INVALID_HANDLE;
+    if (!data || !data_size || !blob || !blob_size) return NTE_INVALID_PARAMETER;
+    if (flags & ~NCRYPT_SILENT_FLAG) FIXME("ignoring flags %#lx\n", flags & ~NCRYPT_SILENT_FLAG);
+    if (descriptor->machine) dpapi_flags |= CRYPTPROTECT_LOCAL_MACHINE;
+
+    in.cbData = data_size;
+    in.pbData = (BYTE *)data;
+    if (!CryptProtectData(&in, NULL, NULL, NULL, NULL, dpapi_flags, &out)) return NTE_FAIL;
+
+    header.magic = PROTECTED_SECRET_MAGIC;
+    header.descriptor_len = wcslen(descriptor->string) + 1;
+    descriptor_bytes = header.descriptor_len * sizeof(WCHAR);
+    size = sizeof(header) + descriptor_bytes + out.cbData;
+
+    if (!(ptr = alloc_secret(para, size)))
+    {
+        LocalFree(out.pbData);
+        return NTE_NO_MEMORY;
+    }
+    memcpy(ptr, &header, sizeof(header));
+    memcpy(ptr + sizeof(header), descriptor->string, descriptor_bytes);
+    memcpy(ptr + sizeof(header) + descriptor_bytes, out.pbData, out.cbData);
+    LocalFree(out.pbData);
+
+    *blob = ptr;
+    *blob_size = size;
+    return ERROR_SUCCESS;
+}
+
+SECURITY_STATUS WINAPI NCryptUnprotectSecret(NCRYPT_DESCRIPTOR_HANDLE *handle, DWORD flags, const BYTE *blob,
+                                             ULONG blob_size, const NCRYPT_ALLOC_PARA *para, HWND hwnd,
+                                             BYTE **data, ULONG *data_size)
+{
+    struct protected_secret_header header;
+    struct protection_descriptor *descriptor = NULL;
+    SIZE_T descriptor_bytes;
+    const WCHAR *string;
+    SECURITY_STATUS ret;
+    DATA_BLOB in, out;
+    BYTE *ptr;
+
+    TRACE("(%p, %#lx, %p, %lu, %p, %p, %p, %p)\n", handle, flags, blob, blob_size, para, hwnd, data, data_size);
+
+    if (!blob || blob_size < sizeof(header)) return NTE_INVALID_PARAMETER;
+    if (flags & ~(NCRYPT_SILENT_FLAG | NCRYPT_UNPROTECT_NO_DECRYPT))
+        FIXME("ignoring flags %#lx\n", flags & ~(NCRYPT_SILENT_FLAG | NCRYPT_UNPROTECT_NO_DECRYPT));
+
+    memcpy(&header, blob, sizeof(header));
+    if (header.magic != PROTECTED_SECRET_MAGIC || !header.descriptor_len) return NTE_BAD_DATA;
+    descriptor_bytes = (SIZE_T)header.descriptor_len * sizeof(WCHAR);
+    if (descriptor_bytes > blob_size - sizeof(header)) return NTE_BAD_DATA;
+    string = (const WCHAR *)(blob + sizeof(header));
+    if (string[header.descriptor_len - 1]) return NTE_BAD_DATA;
+
+    if (handle)
+    {
+        if ((ret = create_descriptor(string, &descriptor))) return ret;
+    }
+
+    if (flags & NCRYPT_UNPROTECT_NO_DECRYPT)
+    {
+        if (handle) *handle = (NCRYPT_DESCRIPTOR_HANDLE)descriptor;
+        return ERROR_SUCCESS;
+    }
+    if (!data || !data_size)
+    {
+        ret = NTE_INVALID_PARAMETER;
+        goto error;
+    }
+
+    in.cbData = blob_size - sizeof(header) - descriptor_bytes;
+    in.pbData = (BYTE *)blob + sizeof(header) + descriptor_bytes;
+    if (!CryptUnprotectData(&in, NULL, NULL, NULL, NULL, CRYPTPROTECT_UI_FORBIDDEN, &out))
+    {
+        ret = NTE_BAD_DATA;
+        goto error;
+    }
+
+    if (!(ptr = alloc_secret(para, out.cbData)))
+    {
+        SecureZeroMemory(out.pbData, out.cbData);
+        LocalFree(out.pbData);
+        ret = NTE_NO_MEMORY;
+        goto error;
+    }
+    memcpy(ptr, out.pbData, out.cbData);
+    *data = ptr;
+    *data_size = out.cbData;
+    SecureZeroMemory(out.pbData, out.cbData);
+    LocalFree(out.pbData);
+
+    if (handle) *handle = (NCRYPT_DESCRIPTOR_HANDLE)descriptor;
+    return ERROR_SUCCESS;
+
+error:
+    if (descriptor) NCryptCloseProtectionDescriptor((NCRYPT_DESCRIPTOR_HANDLE)descriptor);
+    return ret;
+}

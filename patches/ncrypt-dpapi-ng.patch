 #include <bcrypt.h>
 
 #include "wine/test.h"
@@ -832,6 +833,53 @@ static void test_NCryptExportKey(void)
     NCryptFreeObject(prov);
 }
 
+static void test_protect_secret(void)
+{
+    static const BYTE secret[] = "Wine protected secret";
+    NCRYPT_DESCRIPTOR_HANDLE descriptor, descriptor2;
+    BYTE *blob, *data;
+    ULONG blob_size, data_size, i;
+    SECURITY_STATUS ret;
+
+    ret = NCryptCreateProtectionDescriptor(L"LOCAL=user", 0, NULL);
+    ok(ret == NTE_INVALID_PARAMETER, "got %#lx\n", ret);
+
+    descriptor = NULL;
+    ret = NCryptCreateProtectionDescriptor(L"LOCAL=user", 0, &descriptor);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(descriptor != NULL, "got NULL descriptor\n");
+
+    blob = NULL;
+    blob_size = 0;
+    ret = NCryptProtectSecret(descriptor, NCRYPT_SILENT_FLAG, secret, sizeof(secret), NULL, NULL, &blob, &blob_size);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(blob != NULL, "got NULL blob\n");
+    ok(blob_size > sizeof(secret), "got blob size %lu\n", blob_size);
+    for (i = 0; i + sizeof(secret) <= blob_size; i++)
+        if (!memcmp(blob + i, secret, sizeof(secret))) break;
+    ok(i + sizeof(secret) > blob_size, "secret stored in clear text\n");
+
+    data = NULL;
+    data_size = 0;
+    descriptor2 = NULL;
+    ret = NCryptUnprotectSecret(&descriptor2, NCRYPT_SILENT_FLAG, blob, blob_size, NULL, NULL, &data, &data_size);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    ok(data_size == sizeof(secret), "got data size %lu\n", data_size);
+    ok(data && !memcmp(data, secret, sizeof(secret)), "secret mismatch\n");
+    ok(descriptor2 != NULL, "got NULL descriptor\n");
+
+    ret = NCryptCloseProtectionDescriptor(descriptor2);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+    LocalFree(data);
+
+    ret = NCryptUnprotectSecret(NULL, 0, blob, 4, NULL, NULL, &data, &data_size);
+    ok(ret == NTE_INVALID_PARAMETER || ret == NTE_BAD_DATA, "got %#lx\n", ret);
+
+    LocalFree(blob);
+    ret = NCryptCloseProtectionDescriptor(descriptor);
+    ok(ret == ERROR_SUCCESS, "got %#lx\n", ret);
+}
+
 START_TEST(ncrypt)
 {
     test_key_import_rsa();
@@ -844,4 +892,5 @@ START_TEST(ncrypt)
     test_NCryptIsAlgSupported();
     test_NCryptEncrypt();
     test_NCryptExportKey();
+    test_protect_secret();
 }
